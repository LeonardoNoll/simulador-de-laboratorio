function rm_10_coloracao_de_fungos_com_lactofenol_instructions(){
	return [
		"Equipe-se com seu EPI completo;",
		"Separe uma lâmina de vidro e identifique o lado em que irá fazer a coloração.",
		"Cuidadosamente, ligue o bico de bunsen.",
		"Com auxílio de uma pipeta descartável, coloque uma gota de lactofenol azul algodão sobre a lâmina.",
		"Flambe a alça de platina no bico de bunsen para esterilizá-la.",
		"Com auxílio da alça, toque levemente a colônia na placa de cultivo de Ágar Sabouraud Dextrose e leve-a até a lâmina de vidro.",
		"Homogenize a cultura com a gota de lactofenol.",
		"Cuidadosamente, cubra a amostra com a lamínula.",
		"Examine no microscópio óptico nas objetivas de 10 e 40x."
	];
}
