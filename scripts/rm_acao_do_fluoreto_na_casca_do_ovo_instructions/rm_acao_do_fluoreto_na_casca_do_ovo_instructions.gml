function rm_acao_do_fluoreto_na_casca_do_ovo_instructions() {
	return [
		"Com o auxílio de uma caneta permanente, divida os 3 ovos ao meio;",
		"Identifique uma metade como ST (sem tratamento) e a outra metade como: SF(dentifrício sem flúor);",
		"Identifique uma metade como ST (sem tratamento) e a outra metade como: DF(dentifrício fluoretado);",
		"Identifique uma metade como ST (sem tratamento) e a outra metade como: GF (gel fluoretado);",
		"Na metade indicada como SF, DF ou GF,  aplique uma camada espessa do produto correspondente;",
		"Deixe o produto em contato com  a casca do ovo por pelo menos 60 minutos;",
		"Lave os ovos em água corrente e remova os produtos aplicados;",
		"Adicione cuidadosamente 200 ml de ácido acético em um béquer;",
		"Cautelosamente, coloque os ovos tratados dentro do béquer;",
		"Observe as reações que acontecerão nas duas metades do ovo;",
		"Anote na tabela e compare os resultados obtidos."
	];
}
