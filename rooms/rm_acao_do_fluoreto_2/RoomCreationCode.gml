create_textbox(room_width / 3, room_height / 2, "Depois de aproximadamente 3 minutos, o carbonato de cálcio da casca do ovo reagiu com o ácido acético. O desperendimento de bolhas representa a liberação de gás carbônico decorrente da dissolução do carbonato de cálcio.\nLogo, quanto maior a presença de bolhas, maior é a desmineralização")

